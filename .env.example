# Copy to .env locally if needed. Never commit real secrets.

# Project paths
ADUNBOX_PROJECT_DIR=.

# Mode: false = local CSV smoke test, true = direct PostgreSQL extract
ADUNBOX_USE_DATABASE=false

# Local CSV inputs for smoke testing
ADUNBOX_DAILY_INPUT=./data/adunbox_daily_breakdown_kpis.csv
ADUNBOX_HOURLY_INPUT=./data/adunbox_joined_traffic_reports_with_timezone.csv

# PostgreSQL credentials for database mode
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=2
POSTGRES_CONNECT_TIMEOUT=15
POSTGRES_QUERY_TIMEOUT=600
POSTGRES_COMMAND_TIMEOUT=600

# Safe laptop smoke defaults. Increase these in server production if needed.
ADUNBOX_6H_DB_LOOKBACK_DAYS=7
ADUNBOX_6H_DB_ROW_LIMIT=500
ADUNBOX_24H_DB_LOOKBACK_DAYS=7
ADUNBOX_24H_DB_ROW_LIMIT=500
ADUNBOX_24H_DB_RETRY_ON_TIMEOUT=true

# Optional anchor dates for historical testing. Leave empty for current NOW() based production.
ADUNBOX_6H_DB_ANCHOR_DATE=
ADUNBOX_24H_DB_ANCHOR_DATE=

# Feature cache: first run builds cache, repeated runs can reuse it.
ADUNBOX_WRITE_FEATURE_CACHE=true
ADUNBOX_REUSE_FEATURE_CACHE=false

# Optional forecast persistence back into PostgreSQL
ADUNBOX_WRITE_FORECASTS_TO_DB=false
ADUNBOX_FORECAST_TABLE=adunbox_model_forecasts

# Optional model feature-row persistence for DB review/debugging
ADUNBOX_WRITE_FEATURES_TO_DB=false
ADUNBOX_FEATURE_TABLE=adunbox_model_feature_cache

# Optional scope controls for very small laptop smoke tests
ADUNBOX_SCORE_ACCOUNT_IDS=
ADUNBOX_SCORE_MAX_ADS=0
ADUNBOX_6H_SCORE_CHUNKSIZE=25000
