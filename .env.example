# Copy to .env locally if needed. Never commit real secrets.

# Dagster local runtime
# DAGSTER_HOME must be an absolute path — Dagster rejects relative paths.
# For local dev, use run_dagster.sh which sets this automatically.
# For production, set this as an environment variable in your deployment config.
# DAGSTER_HOME=/absolute/path/to/project/.dagster_home_local

# Project paths
ADUNBOX_PROJECT_DIR=.

# Mode: false = local CSV smoke test, true = direct PostgreSQL extract
ADUNBOX_USE_DATABASE=false

# Local CSV inputs for smoke testing
ADUNBOX_DAILY_INPUT=./data/adunbox_daily_breakdown_kpis.csv
ADUNBOX_HOURLY_INPUT=./data/adunbox_joined_traffic_reports_with_timezone.csv

# PostgreSQL credentials for database mode
# Optional one-line DSN. If set, this is used before the individual fields below.
PG_DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=2
POSTGRES_CONNECT_TIMEOUT=15
POSTGRES_QUERY_TIMEOUT=600
POSTGRES_COMMAND_TIMEOUT=600

# Source table mapping.
# Default prefix uses tables like adunbox_traffic_source_reports.
# Set ADUNBOX_DB_TABLE_PREFIX= for tables like traffic_source_reports.
ADUNBOX_DB_TABLE_PREFIX=adunbox_
ADUNBOX_TRAFFIC_SOURCE_REPORTS_TABLE=
ADUNBOX_TRAFFIC_SOURCE_ACCOUNTS_TABLE=
ADUNBOX_TRAFFIC_SOURCE_CAMPAIGNS_TABLE=
ADUNBOX_TRAFFIC_SOURCE_ADSETS_TABLE=
ADUNBOX_TRAFFIC_SOURCE_ADS_TABLE=
ADUNBOX_DAILY_BREAKDOWN_KPIS_TABLE=
ADUNBOX_FORECAST_ELIGIBLE_ADS_TABLE=

# 6h source metric column mapping. Keep defaults for Adunbox-style reports.
# For Vibelets-style reports, commonly use:
# ADUNBOX_6H_REPORTS_REVENUE_COLUMN=conversions_value
# ADUNBOX_6H_REPORTS_CONVERSIONS_COLUMN=conversions
ADUNBOX_6H_REPORTS_REVENUE_COLUMN=tracker_revenue
ADUNBOX_6H_REPORTS_CONVERSIONS_COLUMN=tracker_conversions

# 24h daily source metric column mapping. Keep defaults for Adunbox-style daily rows.
# For Vibelets-style daily rows, commonly use:
# ADUNBOX_24H_DAILY_REVENUE_COLUMN=conversions_value
# ADUNBOX_24H_DAILY_CONVERSIONS_COLUMN=conversions
ADUNBOX_24H_DAILY_REVENUE_COLUMN=tracker_revenue
ADUNBOX_24H_DAILY_CONVERSIONS_COLUMN=tracker_conversions

# true = require account/campaign/adset/ad status ACTIVE.
# false = use reports + accounts/daily tables without hierarchy status filtering.
ADUNBOX_REQUIRE_ACTIVE_HIERARCHY=true

# Safe laptop smoke defaults. Increase these in server production if needed.
ADUNBOX_6H_DB_LOOKBACK_DAYS=8
ADUNBOX_6H_DB_ROW_LIMIT=500
ADUNBOX_24H_DB_LOOKBACK_DAYS=7
ADUNBOX_24H_DB_ROW_LIMIT=500
ADUNBOX_24H_DB_RETRY_ON_TIMEOUT=true
ADUNBOX_6H_BUSINESS_GUARD_MULTIPLIER=5.0
ADUNBOX_6H_REVENUE_ABS_CAP=5000.0
ADUNBOX_6H_CONVERSIONS_ABS_CAP=100.0
ADUNBOX_6H_MAX_SERVED_ROAS=100.0

# Optional anchor dates for historical testing. Leave empty for current NOW() based production.
ADUNBOX_6H_DB_ANCHOR_DATE=
ADUNBOX_24H_DB_ANCHOR_DATE=

# Optional scheduled-activation support.
# false = forecast only currently ACTIVE account/campaign/adset/ad hierarchy.
# true = read public.adunbox_forecast_eligible_ads and include ads scheduled to
# become active inside the forecast window.
ADUNBOX_USE_FORECAST_ELIGIBILITY_VIEW=false

# Optional full SQL overrides if production schedule columns/tables differ.
ADUNBOX_6H_SQL_PATH=
ADUNBOX_24H_SQL_PATH=

# Feature cache: first run builds cache, repeated runs can reuse it.
ADUNBOX_WRITE_FEATURE_CACHE=true
ADUNBOX_REUSE_FEATURE_CACHE=false
ADUNBOX_CLEAN_LOCAL_OUTPUTS_AFTER_DB_WRITE=false

# Optional forecast persistence back into PostgreSQL
ADUNBOX_WRITE_FORECASTS_TO_DB=false
ADUNBOX_FORECAST_TABLE=adunbox_model_forecasts

# Vibelets production DB example:
# ADUNBOX_USE_DATABASE=true
# ADUNBOX_DB_TABLE_PREFIX=
# PG_DATABASE_URL=postgres://vibeuser:your_password@your_vibelets_host:5432/vibelets
# POSTGRES_HOST=your_vibelets_host
# POSTGRES_PORT=5432
# POSTGRES_DB=vibelets
# POSTGRES_USER=vibeuser
# POSTGRES_PASSWORD=your_password
# ADUNBOX_6H_REPORTS_REVENUE_COLUMN=conversions_value
# ADUNBOX_6H_REPORTS_CONVERSIONS_COLUMN=conversions
# ADUNBOX_24H_DAILY_REVENUE_COLUMN=conversions_value
# ADUNBOX_24H_DAILY_CONVERSIONS_COLUMN=conversions
# ADUNBOX_FORECAST_TABLE=vibelets_model_forecasts

# Optional model feature-row persistence for DB review/debugging
ADUNBOX_WRITE_FEATURES_TO_DB=false
ADUNBOX_FEATURE_TABLE=adunbox_model_feature_cache

# Optional scope controls for very small laptop smoke tests
ADUNBOX_SCORE_ACCOUNT_IDS=
ADUNBOX_SCORE_MAX_ADS=0
ADUNBOX_DEBUG_AD_IDS=
ADUNBOX_DEBUG_ACCOUNT_IDS=
ADUNBOX_6H_SCORE_CHUNKSIZE=25000
