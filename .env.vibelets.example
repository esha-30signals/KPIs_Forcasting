# Vibelets / production-like Dagster forecast pipeline env template.
# Copy this file to .env locally, fill credentials, and never commit .env.

DAGSTER_HOME=./.dagster_home_local

ADUNBOX_USE_DATABASE=true
ADUNBOX_DB_TABLE_PREFIX=
ADUNBOX_TRAFFIC_SOURCE_REPORTS_TABLE=traffic_source_reports
ADUNBOX_TRAFFIC_SOURCE_ACCOUNTS_TABLE=traffic_source_accounts
ADUNBOX_TRAFFIC_SOURCE_CAMPAIGNS_TABLE=traffic_source_campaigns
ADUNBOX_TRAFFIC_SOURCE_ADSETS_TABLE=traffic_source_adsets
ADUNBOX_TRAFFIC_SOURCE_ADS_TABLE=traffic_source_ads
ADUNBOX_DAILY_BREAKDOWN_KPIS_TABLE=daily_breakdown_kpis

PG_DATABASE_URL=postgres://vibeuser:<password>@<host>:5432/vibelets

POSTGRES_HOST=<host>
POSTGRES_PORT=5432
POSTGRES_DB=vibelets
POSTGRES_USER=vibeuser
POSTGRES_PASSWORD=<password>

POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=1
POSTGRES_CONNECT_TIMEOUT=60
POSTGRES_QUERY_TIMEOUT=900
POSTGRES_COMMAND_TIMEOUT=900

# Vibelets uses conversions_value/conversions as revenue/conversion sources.
ADUNBOX_6H_REPORTS_REVENUE_COLUMN=conversions_value
ADUNBOX_6H_REPORTS_CONVERSIONS_COLUMN=conversions
ADUNBOX_24H_DAILY_REVENUE_COLUMN=conversions_value
ADUNBOX_24H_DAILY_CONVERSIONS_COLUMN=conversions

# Forecast only active account + campaign + adset + ad hierarchy.
ADUNBOX_REQUIRE_ACTIVE_HIERARCHY=true

# Full production run: keep both empty.
# One account run: ADUNBOX_DEBUG_ACCOUNT_IDS=2488085
# Specific ads run: ADUNBOX_DEBUG_AD_IDS=120890818,125777359
ADUNBOX_DEBUG_ACCOUNT_IDS=
ADUNBOX_DEBUG_AD_IDS=

ADUNBOX_6H_DB_LOOKBACK_DAYS=8
ADUNBOX_6H_DB_ROW_LIMIT=500
ADUNBOX_24H_DB_LOOKBACK_DAYS=21
ADUNBOX_24H_DB_ROW_LIMIT=500
ADUNBOX_24H_DB_RETRY_ON_TIMEOUT=true

# 6h business safety guard.
ADUNBOX_6H_BUSINESS_GUARD_MULTIPLIER=5.0
ADUNBOX_6H_REVENUE_ABS_CAP=5000.0
ADUNBOX_6H_CONVERSIONS_ABS_CAP=100.0
ADUNBOX_6H_MAX_SERVED_ROAS=100.0

ADUNBOX_WRITE_FORECASTS_TO_DB=true
ADUNBOX_FORECAST_TABLE=vibelets_model_forecasts

# Forecast table writes both system timestamps and account-local business timestamps:
# forecast_anchor / forecast_window_start / forecast_window_end
# timezone / forecast_anchor_local / forecast_window_start_local / forecast_window_end_local / forecast_local_date

ADUNBOX_WRITE_FEATURE_CACHE=false
ADUNBOX_REUSE_FEATURE_CACHE=false
ADUNBOX_CLEAN_LOCAL_OUTPUTS_AFTER_DB_WRITE=true

ADUNBOX_USE_FORECAST_ELIGIBILITY_VIEW=false
ADUNBOX_FORECAST_ELIGIBLE_ADS_TABLE=
